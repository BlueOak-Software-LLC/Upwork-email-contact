# ---------------------------------------------------------------------------
# Copy to `.env.local` (frontend dev) and to Vercel Project Settings → Env Vars
# ---------------------------------------------------------------------------

# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...public-role-key
# Server-only. Bypasses RLS. NEVER expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role-key

# --- API protection --------------------------------------------------------
# Optional. When set, every /api/* call must send `x-api-key: <value>`
# (a valid logged-in Supabase user session is also accepted).
# Generate: openssl rand -hex 32
API_MASTER_KEY=

# --- Outgoing email --------------------------------------------------------
# resend | smtp | log   ("log" prints to stdout, no credentials needed)
EMAIL_PROVIDER=log
EMAIL_FROM="Upwork Outreach <hello@yourdomain.com>"
EMAIL_REPLY_TO=

RESEND_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for implicit TLS (port 465), false for STARTTLS (port 587)
SMTP_SECURE=false

# --- Email tracking --------------------------------------------------------
# Requires supabase/migrations/0005_email_tracking.sql to be applied.
# On by default; forced off whenever EMAIL_PROVIDER=log, because a dry run
# delivers nothing that could ever load a pixel.
EMAIL_TRACKING=true
# Rewrite http(s) URLs found in the email body to /c/<token>. Opens work
# without it. Links inside the attached proposal PDF are never rewritten.
LINK_TRACKING=true
# Public HTTPS origin that serves /o/<token>.gif and /c/<token>. Must be THIS
# app, reachable by the recipient without a login or a deployment password.
# Defaults to NEXT_PUBLIC_APP_URL. Keep it stable after sending: already
# delivered messages contain the original URLs.
TRACKING_DOMAIN=
# Days of open/click rows kept before /api/maintenance/purge deletes them.
TRACKING_RETENTION_DAYS=365
# Guards the purge route when a scheduler calls it. Generate: openssl rand -hex 32
CRON_SECRET=

# --- AI generation: which model writes proposals ---------------------------
# The chain is Puter → Groq → Gemini. A provider with no credential (neither a
# key saved on /settings/models nor the env var below) is SKIPPED, never counted
# as a failure. Values saved on /settings/models override everything here.
# Saving from that page needs supabase/migrations/0006_ai_settings.sql and
# APP_ENCRYPTION_KEY; without either, these env vars still generate normally.
#
# auto  = follow AI_PROVIDER_ORDER (default puter,groq,gemini)
# puter | groq | gemini = prefer that provider, then continue down the order
# none  = generation off
AI_PROVIDER=auto
# Order the chain tries, comma-separated. Unknown names are dropped.
AI_PROVIDER_ORDER=puter,groq,gemini
# What answers when the preferred provider FAILS — spent allowance, revoked
# token, 429, refused prompt, gateway outage. auto = the rest of the order.
# none = one leg only (strict mode; nothing silently costs money elsewhere).
AI_FALLBACK_PROVIDER=auto
# Wall clock for the whole generation INCLUDING fallback attempts. A leg gets
# min(its own timeout, what is left after reserving AI_MIN_ATTEMPT_MS for every
# provider behind it); a leg with less than AI_MIN_ATTEMPT_MS left is skipped
# rather than half-run, because a function killed mid-JSON is worse than no
# document. The reservation is what makes Gemini reachable after a slow Puter.
# Keep AI_MAX_TOTAL_MS under the route's maxDuration (120s).
AI_MAX_TOTAL_MS=110000
AI_MIN_ATTEMPT_MS=20000

# --- Puter (first choice; free :free models) --------------------------------
# Not an API key you buy: a login token for a Puter account, and that account is
# billed for usage ("User-Pays"). The :free models below cost nothing per token,
# but the account still has a daily/monthly allowance — top it up if Puter starts
# returning insufficient_funds; until then the chain falls through to Groq.
#   npm i -g @heyputer/puter-cli && puter login      # browser flow, prints token
#   puter whoami                                     # confirm which account
# Treat the token as a password: it can read that account's cloud.
PUTER_AUTH_TOKEN=
PUTER_API_ORIGIN=https://api.puter.com
# Largest free text model in Puter's catalogue: 550B, 1M context, 64K output —
# the headroom a 12k-token PPD needs. The :free suffix is what makes it free.
PUTER_MODEL=openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
# Tried once inside Puter if the first model refuses or is unavailable.
PUTER_FALLBACK_MODEL=openrouter:nvidia/nemotron-3.5-lightning:free
# Completion budget shared by every provider. Defaults to GROQ_MAX_TOKENS.
# AI_MAX_TOKENS=12000
# Upper bound for one Puter call. The chain shortens it when needed to keep a
# minimum attempt for Groq/Gemini. Must stay under the route's maxDuration (120s).
AI_TIMEOUT_MS=105000

# --- Groq (second choice; free developer tier) ------------------------------
# Strong free-tier quality, ~10x faster per token and cheaper, but the developer
# tier allows ~8k tokens/minute and ~200k/day (~35 documents). Get a key at
# https://console.groq.com/keys. ⚠ Rotate any key ever pasted into a chat/ticket.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=45000
# Completion budget for the ONE call that returns both the PPD and the email.
# GPT-OSS bills its hidden reasoning against this same cap (a measured run spent
# 6,296 of 8,000 tokens thinking), so it needs real headroom.
GROQ_MAX_TOKENS=12000
# Your organization's tokens-per-minute allowance for that model. This key's tier
# allows 8,000, so a 12k request is rejected with HTTP 413; the client clamps the
# completion budget to fit and re-reads the real limit from a 413 before retrying.
GROQ_TOKENS_PER_MINUTE=8000
# none | minimal | low | medium | high — measured here: low ≈ 6s/$0.0013 but terse
# (~500 words), medium ≈ 22s/$0.0021 with fuller prose, high ≈ 19s/$0.005 and
# reasoning can eat the whole completion budget. medium is the balance.
# The client tunes this DOWN automatically (never up) when the tokens left after
# the prompt fall under ~4,200 (→ low) or ~2,600 (→ none), because GPT-OSS bills
# reasoning inside the completion budget and your tier is 8,000 TPM all-in.
# Unset = omit the field.
GROQ_REASONING_EFFORT=medium
# Published list price per million tokens, used only to log estimated cost/proposal.
GROQ_PRICE_INPUT_PER_M=0.15
GROQ_PRICE_OUTPUT_PER_M=0.60

# --- Gemini (last resort; free tier) ----------------------------------------
# Reached only when Puter and Groq are both unconfigured or both fail. No key =
# skipped entirely. Free tier is generous but per-model daily quotas apply; a
# 429 here is the last leg failing, not a reason to retry forever.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=90000
PROPOSAL_LANGUAGE=English
# Branding stamped onto every proposal PDF. These OVERRIDE anything the model
# wrote, so the LLM can never invent our company name or reply address.
PROPOSAL_COMPANY=
PROPOSAL_WEBSITE=
PROPOSAL_PREPARED_BY=
# Printed under the name in the PDF and in every email sign-off.
PROPOSAL_TITLE=
# e.g. USD 45-65/hour - indicative, confirmed after a scoping call
PROPOSAL_RATE=
# Deprecated and ignored. Ingest always stores only: a lead is `received`/
# `enriched` and nothing is spent until someone clicks "Generate PPD" on the
# lead page (or POSTs /api/leads/<id>/generate). The only inline-generation
# switch is an explicit ?auto=true on POST /api/leads. Setting this true now
# logs an "ignored" diagnostic and still does not generate.
# AUTO_ENRICH_LEADS=false

# --- Proposal PDF (pdfme) --------------------------------------------------
# pdfme = compile a template from the PPD per proposal (lib/pdfme/compiler.ts)
# none  = skip PDFs (PPD JSON + dashboard view still work)
PDF_PROVIDER=pdfme
# Reference copy of one compiled document - import it into pdfme.com/template-design
# to inspect or re-style the geometry. Runtime templates are generated per proposal.
PDFME_TEMPLATE_PATH=templates/pdfme/proposal-template.json

# --- Secret storage --------------------------------------------------------
# Encrypts sender_accounts SMTP passwords and ai_settings API keys (AES-256-GCM)
# before they hit Postgres. Required to save a key on /settings/models.
# Changing it invalidates the stored secrets; re-save them.
# Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
