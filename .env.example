# ---------------------------------------------------------------------------
# Copy to `.env.local` (frontend dev) and to Vercel Project Settings → Env Vars
# ---------------------------------------------------------------------------

# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...public-role-key
# Server-only. Bypasses RLS. NEVER expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role-key
# Production always requires a Supabase Auth session; development is open by
# default. Set true to test the login gate with `npm run dev`.
REQUIRE_SESSION=false

# --- API protection --------------------------------------------------------
# Optional. When set, every /api/* call must send `x-api-key: <value>`
# (a valid logged-in Supabase user session is also accepted).
# Generate: openssl rand -hex 32
API_MASTER_KEY=

# --- Outgoing email --------------------------------------------------------
# resend | smtp | log   ("log" prints to stdout, no credentials needed)
EMAIL_PROVIDER=log
EMAIL_FROM="Upwork Outreach <hello@yourdomain.com>"
EMAIL_REPLY_TO=

RESEND_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for implicit TLS (port 465), false for STARTTLS (port 587)
SMTP_SECURE=false

# --- Email tracking --------------------------------------------------------
# Requires supabase/migrations/0005_email_tracking.sql to be applied.
# On by default; forced off whenever EMAIL_PROVIDER=log, because a dry run
# delivers nothing that could ever load a pixel.
EMAIL_TRACKING=true
# Rewrite http(s) URLs found in the email body to /c/<token>. Opens work
# without it. Links inside the attached proposal PDF are never rewritten.
LINK_TRACKING=true
# Public HTTPS origin that serves /o/<token>.gif and /c/<token>. Must be THIS
# app, reachable by the recipient without a login or a deployment password.
# Defaults to NEXT_PUBLIC_APP_URL. Keep it stable after sending: already
# delivered messages contain the original URLs.
TRACKING_DOMAIN=https://email.blueoaksoftware.cloud
# Days of open/click rows kept before /api/maintenance/purge deletes them.
TRACKING_RETENTION_DAYS=365
# Guards the purge route when a scheduler calls it. Generate: openssl rand -hex 32
CRON_SECRET=

# --- Prompt content --------------------------------------------------------
# Prompts are rendered here and written in the ChatGPT tab the user is already
# signed in to. There is no model API key in this app.
PROPOSAL_LANGUAGE=English
# Fallback identity ONLY when no sender profile exists yet. The real name, role,
# phone, WhatsApp, LinkedIn, website, location and experience live in
# Settings -> Senders & profile and are chosen per lead. No company name is
# printed on the PPD or in an email.
# PROPOSAL_COMPANY is legacy and ignored by the document; it remains in the
# schema so old env files still parse.
PROPOSAL_WEBSITE=
PROPOSAL_PREPARED_BY=
# Fallback role printed under the name when no profile exists.
PROPOSAL_TITLE=
# e.g. USD 45-65/hour - indicative, confirmed after a scoping call
PROPOSAL_RATE=
# Deprecated and ignored. Ingest always stores only: a lead is `received`/
# `enriched` and nothing runs until someone clicks "Generate PPD" on the lead
# page. Generation now runs in the signed-in ChatGPT tab through the companion
# extension, not on the server.
# AUTO_ENRICH_LEADS=false

# --- Proposal PDF (pdfme) --------------------------------------------------
# pdfme = compile a template from the PPD per proposal (lib/pdfme/compiler.ts)
# none  = skip PDFs (PPD JSON + dashboard view still work)
PDF_PROVIDER=pdfme
# Reference copy of one compiled document - import it into pdfme.com/template-design
# to inspect or re-style the geometry. Runtime templates are generated per proposal.
PDFME_TEMPLATE_PATH=templates/pdfme/proposal-template.json

# --- Secret storage --------------------------------------------------------
# Encrypts sender_accounts SMTP passwords (AES-256-GCM) before they hit
# Postgres. Changing it invalidates the stored passwords; re-save them.
# Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Chrome extension ID for the ChatGPT session bridge. The bundled extension in
# `chatgpt-extension/` has a fixed key and therefore this ID; override only if
# you replace the key. No OpenAI/ChatGPT API key is used by PPD or email jobs.
NEXT_PUBLIC_CHATGPT_EXTENSION_ID=phieeciapeplplficoclmjenfbmbdcke
LOG_LEVEL=info
