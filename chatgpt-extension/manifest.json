{
  "manifest_version": 3,
  "name": "Upwork Email Contact — ChatGPT session",
  "version": "1.0.4",
  "description": "Runs Upwork Email Contact PPD and email prompts in the ChatGPT tab you are signed in to. No API key.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "offscreen",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Upwork Email Contact ChatGPT bridge"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*",
      "https://upwork-email-contact.vercel.app/*",
      "https://upwork-email-contact-coredev367.vercel.app/*"
    ]
  }
}
