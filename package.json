{
  "name": "upwork-email-contact",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Next.js 15 dashboard (Supabase) + JSON/email API for Upwork outreach",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "format": "prettier --write .",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/database.ts",
    "db:local": "supabase start",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.90.2",
    "clsx": "^2.1.1",
    "next": "^15.5.4",
    "nodemailer": "^7.0.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "resend": "^6.0.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.7.0",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  }
}
